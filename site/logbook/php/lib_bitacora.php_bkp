function list_fallas_core_Telefonia($xop){

        global $intradb;
        global $intraserver;
        global $intrauser;
        global $intrapass;

        $data='';
	$data="<option value=-1>- Seleccione Falla </option>";
        $sql ='';
        $sql.="
		SELECT A.IDREL as IDREL , A.IDTIPO, A.IDFALLA, B.DESCRIPCION_FALLA,  C.DESCRIPCION
		  FROM REL_TIPOS_FALLAS A
			INNER JOIN FALLAS_BITACORA B ON (A.IDFALLA = B.IDFALLA) 
			INNER JOIN TIPO_FALLAS C ON (C.IDTIPO = A.IDTIPO) 
		  where  A.IDTIPO=$xop ORDER BY  B.DESCRIPCION_FALLA asc ";
	//echo $sql;

	$link_om = mysafe_read($intraserver,$intrauser, $intrapass) or my_die("Could not connect");
	$link->select_db($intradb);

	$result = execute_qry($sql,$link_om);
	$cntrow = mysqli_num_rows($result);
	$str_select ='';

	if ($cntrow >0){
		while ($row = mysqli_fetch_array($result)){
			$str_select ='';
			if ($iduser == $row[0]){
				$str_select =' selected ';
                }
                 $data .= "<option $str_select  value='$row[0]'>$row[3]</option>";
                }
        }
        $result->free_result();
        $link->close();
        return $data;
}


