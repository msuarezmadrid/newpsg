function list_regiones($xidpais='-1'){

        global $intradb;
        global $intraserver;
        global $intrauser;
        global $intrapass;

	$strvalor = ($xidpais == '-1' ? "ID_PAIS" : "'$xidpais'");

        $data='';
	$data="<option value='-1' selected>- Seleccione Region </option>";
        $sql ='';
        $sql.="Select ID_PAIS, ID_REGION, REGION From REGIONES Where ID_PAIS =$strvalor order by REGION " ;

	$link_om = mysafe_read($intraserver,$intrauser, $intrapass) or my_die("Could not connect");
	$link->select_db($intradb);

	$result = execute_qry($sql,$link_om);
	$cntrow = mysqli_num_rows($result);
	$str_select ='';

	if ($cntrow >0){
		while ($row = mysqli_fetch_array($result)){
			$str_select ='';
			if ($xidpais == $row[1]){
				$str_select =' selected ';
			}

			$data .= "<option $str_select  value='$row[0];$row[1]'>$row[2]</option>";
		}
	}
	$result->free_result();
	$link->close();
	return $data;

}

function list_zona($xidpais='-1',$xidregi='-1'){

        global $intradb;
        global $intraserver;
        global $intrauser;
        global $intrapass;

	$strpais = ($xidpais == "-1" ? "IFNULL(ID_PAIS,'')"   : "'$xidpais'");
	$strregi = ($xidregi == "-1" ? "IFNULL(ID_REGION,'')" : "'$xidregi'");
	

        $data='';
	$data="<option value=-1>- Seleccione Zona </option>";
        $sql ='';

	//echo "..:$xidpais...:$xidregi";

	$sql.="Select ID_PAIS, IFNULL(ID_REGION,-1), IFNULL(ID_ZONA,-1), ZONA From ZONA 
		where IFNULL(ID_PAIS,'')=$strpais and IFNULL(ID_REGION,'')=$strregi order by ZONA asc";

	//echo "<br>$sql";

	$link_om = mysafe_read($intraserver,$intrauser, $intrapass) or my_die("Could not connect");
	$link->select_db($intradb);

	$result = execute_qry($sql,$link_om);
	$cntrow = mysqli_num_rows($result);
	$str_select ='';

	if ($cntrow >0){
		while ($row = mysqli_fetch_array($result)){
			$str_select ='';
			if ($iduser == $row[1]){
				$str_select =' selected ';
			}
			$data .= "<option $str_select  value='$row[0];$row[1];$row[2]'>$row[3]</option>";
		}
	}
	$result->free_result();
	$link->close();
	return $data;

}



function list_ubicaciones($xidpais='-1',$xidregi='-1',$xidzona='-1',$xidlugar='-1'){

	global $intradb;
	global $intraserver;
	global $intrauser;
	global $intrapass;


	$strzona = ($xidzona == "-1" ? "Z.ID_ZONA"   : "'$xidzona'");

	$data='';
	$data="<option value='-1'>- Seleccione Lugar </option>";
	$sql ='';
	$sql.="SELECT Z.ID_PAIS, IFNULL(Z.ID_REGION,-1), IFNULL(Z.ID_ZONA,-1), L.ID_LUGAR ,  L.LUGAR
		FROM LUGAR L INNER JOIN ZONA Z ON (Z.ID_ZONA = L.ID_ZONA)
		Where Z.ID_ZONA = $strzona order by LUGAR asc";

	//echo $sql;

	$link_om = mysafe_read($intraserver,$intrauser, $intrapass) or my_die("Could not connect");
	$link->select_db($intradb);

	$result = execute_qry($sql,$link_om);
	$cntrow = mysqli_num_rows($result);
	$str_select ='';

	if ($cntrow >0){
		while ($row = mysqli_fetch_array($result)){
			$str_select ='';
			//if ($iduser == $row[1]){
			//        $str_select =' selected ';
			//}
			$data .= "<option $str_select  value='$row[0];$row[1];$row[2];$row[3]'>$row[4]</option>";
		}
	}
	$result->free_result();
	$link->close();
	return $data;

}

